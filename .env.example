# Copy this file to .env and fill in your values. NEVER commit .env.
# In GitHub Actions, add the same names as repository secrets instead.

# ---------- AI model (pick one; Gemini has a free tier) ----------
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier quotas are per model per day (gemini-3.5-flash allows only 20/day), so the
# agent starts on gemini-3.5-flash-lite and automatically switches to the next model
# when one is exhausted, retired or overloaded.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Alternative free options (OpenAI-compatible APIs)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Force a provider: gemini | groq | openrouter | none (none = keyword-only mode)
# LLM_PROVIDER=
# Seconds between AI calls (free tiers allow ~10 requests/minute)
# LLM_MIN_INTERVAL_SECONDS=7

# ---------- Web search ----------
# Optional. Without it the agent uses free DuckDuckGo/Bing metasearch (ddgs).
# Free key (1,000 searches/month): https://tavily.com
# TAVILY_API_KEY=

# ---------- Email (Gmail example) ----------
# Gmail needs an "App password": Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_TO=you@gmail.com
